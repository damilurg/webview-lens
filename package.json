{
    "name": "webview-lens",
    "version": "0.2.0",
    "description": "Inspect, override and measure any web app inside Android WebView & iOS WKWebView (macOS & Windows): fixed DevTools URL, local dev server behind production HTTPS, live logs, lab Web Vitals with CI budgets, and a zero-dep RUM + Prometheus toolkit.",
    "keywords": [
        "webview",
        "android",
        "ios",
        "wkwebview",
        "devtools",
        "cdp",
        "chrome-devtools-protocol",
        "webkit-inspector",
        "adb",
        "usbmuxd",
        "mitm",
        "web-vitals",
        "rum",
        "real-user-monitoring",
        "prometheus"
    ],
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22.4.0"
    },
    "bin": {
        "webview-lens": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/node/index.d.ts",
            "default": "./dist/node/index.js"
        },
        "./rum": {
            "types": "./dist/rum/index.d.ts",
            "default": "./dist/rum/index.js"
        },
        "./rum/server": {
            "types": "./dist/rum/server.d.ts",
            "default": "./dist/rum/server.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
        "prebuild": "npm run clean",
        "build": "tsc -p tsconfig.build.json",
        "postbuild": "node -e \"import('node:fs').then(fs => { try { fs.chmodSync('dist/cli.js', 0o755); } catch {} })\"",
        "check": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test \"test/**/*.test.ts\"",
        "bench": "node test/bench/hot-paths.bench.ts",
        "verify": "npm run format:check && npm run check && npm test",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "prettier": "3.9.10",
        "typescript": "6.0.3"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.4.0",
            "onFail": "warn"
        }
    }
}
