{
    "name": "webview-lens",
    "version": "0.3.3",
    "description": "Debug Android WebView and iOS WKWebView with Chrome DevTools on macOS, Windows and Linux: a fixed DevTools URL (chrome://inspect alternative), your localhost dev server inside the app behind the production HTTPS origin, console logs in the terminal, lab Web Vitals with CI budgets, and a zero-dependency RUM + Prometheus toolkit.",
    "keywords": [
        "webview",
        "android",
        "ios",
        "android-webview",
        "wkwebview",
        "ios-webview",
        "webview-debugging",
        "remote-debugging",
        "devtools",
        "chrome-devtools",
        "chrome-inspect",
        "safari-web-inspector",
        "web-inspector",
        "ios-webkit-debug-proxy",
        "cdp",
        "chrome-devtools-protocol",
        "webkit-inspector-protocol",
        "hybrid-app",
        "capacitor",
        "cordova",
        "ionic",
        "react-native-webview",
        "mobile-debugging",
        "adb",
        "usbmuxd",
        "https-proxy",
        "mitm",
        "localhost",
        "dev-server",
        "hmr",
        "nextjs",
        "nuxt",
        "sveltekit",
        "angular",
        "vite",
        "web-vitals",
        "core-web-vitals",
        "performance-budget",
        "rum",
        "real-user-monitoring",
        "prometheus"
    ],
    "license": "MIT",
    "author": "damilurg <rootdamilurg@gmail.com>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/damilurg/webview-lens.git"
    },
    "homepage": "https://github.com/damilurg/webview-lens#readme",
    "bugs": {
        "url": "https://github.com/damilurg/webview-lens/issues"
    },
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=22.4.0"
    },
    "bin": {
        "webview-lens": "dist/cli.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/node/index.d.ts",
            "default": "./dist/node/index.js"
        },
        "./rum": {
            "types": "./dist/rum/index.d.ts",
            "default": "./dist/rum/index.js"
        },
        "./rum/server": {
            "types": "./dist/rum/server.d.ts",
            "default": "./dist/rum/server.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "docs",
        "README.md",
        "CHANGELOG.md",
        "LICENSE",
        "llms.txt"
    ],
    "scripts": {
        "clean": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\"",
        "prebuild": "npm run clean",
        "build": "tsc -p tsconfig.build.json",
        "postbuild": "node -e \"import('node:fs').then(fs => { try { fs.chmodSync('dist/cli.js', 0o755); } catch {} })\"",
        "check": "tsc -p tsconfig.json",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test \"test/**/*.test.ts\"",
        "bench": "node test/bench/hot-paths.bench.ts",
        "demo:rum": "npm run build && node examples/rum/server.ts",
        "examples:sync": "node scripts/sync-examples.ts",
        "examples:check": "node scripts/sync-examples.ts --check",
        "verify": "npm run format:check && npm run check && npm run examples:check && npm test",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "@types/node": "22.20.6",
        "prettier": "3.9.10",
        "typescript": "6.0.3"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=22.18.0",
            "onFail": "warn"
        }
    }
}
