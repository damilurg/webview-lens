{
    // Emits the Node part of the package (CLI, webview-lens, webview-lens/rum/server) to dist/.
    // The browser entry points are emitted by tsconfig.build.web.json into the same dist/.
    "extends": "./tsconfig.node.json",
    "compilerOptions": {
        "composite": false,
        "incremental": false,
        "noEmit": false,
        "rootDir": "src",
        "outDir": "dist",
        "declaration": true,
        "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["src/rum/index.ts", "src/viewport"]
}
